rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} { allow read: if isOwner(uid); allow write: if false; }

    match /users/{uid}    { allow read, write: if isOwner(uid); }
    match /profiles/{uid} { allow read, write: if isOwner(uid); }
    match /settings/{uid} { allow read, write: if isOwner(uid); }

    match /shoppingLists/{docId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /shoppingItems/{docId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /shoppingHistory/{docId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /userProducts/{docId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /userFavourites/{docId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /notifications/{docId} {
      allow read, write: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /crowdsourcedPrices/{docId} {
      allow read:  if signedIn();
      allow write: if signedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /products/{docId}   { allow read: if signedIn(); allow write: if isAdmin(); }
    match /prices/{docId}     { allow read: if signedIn(); allow write: if isAdmin(); }
    match /stores/{docId}     { allow read: if signedIn(); allow write: if isAdmin(); }
    match /catalogues/{docId} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /promotions/{docId} { allow read: if signedIn(); allow write: if isAdmin(); }
  }
}